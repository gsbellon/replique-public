#!/bin/sh
# Rebuild everything: verification, calibration, figures, manuscript and supplementary material.
# Usage: sh make.sh <path to the unzipped dataset>
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(dirname "$HERE")"
DATA="$1"
python3 "$HERE/verify_theory.py" "$ROOT/output"
python3 -I "$HERE/calibrate.py" "$DATA" "$ROOT/output" > "$ROOT/output/calibration_log.txt"
python3 "$HERE/figures.py" "$ROOT/output/results.json" "$ROOT/figures"
python3 "$HERE/graphical_abstract.py" "$ROOT/output/results.json" "$ROOT/figures"
python3 "$HERE/build_manuscript.py" "$ROOT/output/results.json" "$ROOT/tex" "$ROOT/manuscript"
cp "$ROOT"/figures/Figure_*.pdf "$ROOT/manuscript/"
cd "$ROOT/manuscript"
pdflatex -interaction=nonstopmode manuscript.tex > /dev/null
bibtex manuscript > /dev/null
pdflatex -interaction=nonstopmode manuscript.tex > /dev/null
pdflatex -interaction=nonstopmode manuscript.tex > /dev/null
pdflatex -interaction=nonstopmode manuscript.tex > /dev/null
# the supplementary material reads the cross-references of the manuscript
grep '^\\newlabel' manuscript.aux > paper_labels.aux
pdflatex -interaction=nonstopmode supplement.tex > /dev/null
bibtex supplement > /dev/null
pdflatex -interaction=nonstopmode supplement.tex > /dev/null
pdflatex -interaction=nonstopmode supplement.tex > /dev/null
echo "built: $ROOT/manuscript/manuscript.pdf and $ROOT/manuscript/supplement.pdf"
# ----
