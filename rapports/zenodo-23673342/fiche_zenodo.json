{"created": "2026-10-26T18:29:03.795127+00:00", "modified": "2026-11-20T11:15:12.946194+00:00", "id": 23673342, "conceptrecid": "23673341", "doi": "10.5281/zenodo.23673342", "conceptdoi": "10.5281/zenodo.23673341", "doi_url": "https://doi.org/10.5281/zenodo.23673342", "metadata": {"title": "Fixed-reference Benefit-of-the-Doubt index on Alkire-Foster censored headcounts: replication package", "doi": "10.5281/zenodo.23673342", "publication_date": "2026-10-26", "description": "<p>Replication package for the article &ldquo;Endogenous weights and a fixed reference in territorial multidimensional poverty measurement&rdquo;. The method evaluates Alkire-Foster censored deprivation headcounts of the Brazilian states against a frozen 2010 reference with a proportional coefficient restriction.</p>\n<p>The archive contains the R implementation, a single entry point (run_all.R), replication instructions in English, variable documentation, aggregate results for 2010 and 2022 with a historical extension to 1991 and 2000, robustness results, tests and SHA-256 checksums. Census microdata and household intermediate files are not redistributed. The main 2010 and 2022 scripts obtain the official public inputs from IBGE; the historical extension requires separately obtained SPSS samples identified in the documentation. Subgroup consistency applies to groups of whole states with fixed population shares, not to arbitrary partitions of persons within a state.</p>\n<p>Code and documentation: MIT license. Repository: https://github.com/moisesluna2026/bod-fixed-mpi</p>", "access_right": "open", "creators": [{"name": "Brand\u00e3o, Mois\u00e9s Luna", "affiliation": null}, {"name": "Mariano, Enzo Barberio", "affiliation": null}, {"name": "Rebelatto, Daisy Aparecida do Nascimento", "affiliation": null}], "keywords": ["multidimensional poverty"], "version": "1.0.0", "custom": {"code:codeRepository": "https://github.com/moisesluna2026/bod-fixed-mpi", "code:programmingLanguage": [{"id": "r", "title": {"en": "R"}}]}, "resource_type": {"title": "Software", "type": "software"}, "license": {"id": "mit-license"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23673341"}}]}}, "title": "Fixed-reference Benefit-of-the-Doubt index on Alkire-Foster censored headcounts: replication package", "links": {"self": "https://zenodo.org/api/records/23673342", "self_html": "https://zenodo.org/records/23673342", "preview_html": "https://zenodo.org/records/23673342?preview=1", "doi": "https://doi.org/10.5281/zenodo.23673342", "self_doi": "https://doi.org/10.5281/zenodo.23673342", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23673342", "reserve_doi": "https://zenodo.org/api/records/23673342/draft/pids/doi", "parent": "https://zenodo.org/api/records/23673341", "parent_html": "https://zenodo.org/records/23673341", "parent_doi": "https://doi.org/10.5281/zenodo.23673341", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23673341", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23673342/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23673342/sequence/default", "files": "https://zenodo.org/api/records/23673342/files", "media_files": "https://zenodo.org/api/records/23673342/media-files", "latest": "https://zenodo.org/api/records/23673342/versions/latest", "latest_html": "https://zenodo.org/records/23673342/latest", "versions": "https://zenodo.org/api/records/23673342/versions", "draft": "https://zenodo.org/api/records/23673342/draft", "access_links": "https://zenodo.org/api/records/23673342/access/links", "access_grants": "https://zenodo.org/api/records/23673342/access/grants", "access_users": "https://zenodo.org/api/records/23673342/access/users", "access_request": "https://zenodo.org/api/records/23673342/access/request", "access": "https://zenodo.org/api/records/23673342/access", "communities": "https://zenodo.org/api/records/23673342/communities", "communities-suggestions": "http