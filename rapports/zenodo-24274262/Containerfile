FROM docker.io/library/python@sha256:05a994d2344eb364cc186910f4fc8786a38215f39f00d0acc25bff33a08f4177
# Image de base : python:3.12-slim (image_base.log). Le paquet exige Python 3.12 (.python-version, pyproject.toml) et
# verrouille toutes ses dépendances dans uv.lock : uv 0.13.9 (version exacte, uv_versions.log) installe l'environnement
# du verrou tel quel (--frozen), avec le Python du système. Réseau nécessaire à la construction seulement (PyPI) ;
# les exécutions restent --network none. Contexte de construction : pyproject.toml, uv.lock, .python-version du paquet.
RUN pip install --no-cache-dir uv==0.13.9
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
ENV UV_PYTHON_PREFERENCE=only-system UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/app/.venv
RUN uv sync --frozen --no-install-project
