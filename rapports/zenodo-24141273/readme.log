"""Reproduce every table and figure of the paper and its Supplementary Material.

Usage:  python run_all.py            (from the package root; about 1-2 hours on a laptop)
        python run_all.py --from 40  (start from a given step)

Steps 00 and 00b (re-extracting the raw files from the full source downloads; capital coordinates) are skipped by default because the
filtered extracts and the coordinates are shipped in data/raw/ and data/reference/
"""
import subprocess, sys, time
from pathlib import Path

CODE = Path(__file__).resolve().parent / "code"
STEPS = sorted(p.name for p in CODE.glob("[0-9][0-9]*.py") if not p.name.startswith("00"))
start = sys.argv[sys.argv.index("--from") + 1] if "--from" in sys.argv else "01"
log = open(Path(__file__).resolve().parent / "output" / "run_all.log", "w")
for s in STEPS:
    if s[:2] < start:
        continue
    t = time.time(); print(f"[run_all] {s} ...", flush=True)
    r = subprocess.run([sys.executable, s], cwd=CODE, capture_output=True, text=True)
    log.write(f"===== {s} ({time.time() - t:.0f}s, exit {r.returncode})\n{r.stdout}\n{r.stderr}\n"); log.flush()
    if r.returncode != 0:
        print(r.stderr[-3000:]); sys.exit(f"[run_all] {s} failed")
    print(f"[run_all] {s} done in {time.time() - t:.0f}s", flush=True)
print("[run_all] all steps completed; tables in output/tables, figures in output/figures, results in output/results")
